{
  "name": "twofold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "echo 'Starting Next. The first Ready line can take a minute with no other output.' && NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack --hostname 127.0.0.1",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/link-nested-postcss-deps.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
